CONFIG_IDF_TARGET="esp32s3"
# Badge: ESP32-S3R8 (8 MB embedded octal PSRAM, AP 3V3) + 8 MB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# 1 tick = 1 ms, so the EPD driver's ms delays are exact.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Crystal code runs on the main task (EPD, PNG, games): give it room.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
# Partitions: two 3 MB OTA slots (partitions.csv); the bootloader rolls a new
# image back unless it marks itself valid (src/ota.cr, after the display is up).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# OTA over HTTPS (GitHub releases): the CA bundle; Wi-Fi/LWIP and mbedTLS
# buffers may live in PSRAM so the internal heap stays free for DMA.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
