# Writes src/robots/trig.cr: upstream's CROBOTS TRIG_TBL (sin * 100000 for
# 0..90 degrees) as a string literal, 3 little-endian bytes per entry:
#   crystal run crystal/firmware/test/robots/gen_trig.cr
require "./upstream/src/battle/field"

body = String.build do |io|
  CrystalRobots::Battle::TRIG_TBL.each do |v|
    io.printf("\\x%02X\\x%02X\\x%02X", v & 255, (v >> 8) & 255, v >> 16)
  end
end

File.write("#{__DIR__}/../../src/robots/trig.cr", <<-CR)
# Generated by test/robots/gen_trig.cr from crystal-robots' TRIG_TBL; do
# not edit. sin * 100000 for 0..90 degrees (CROBOTS avoids floating point
# for motion), 3 little-endian bytes per entry.
module RB
  def self.trig_table : UInt8*
    "#{body}".to_unsafe
  end
end

CR
puts "wrote src/robots/trig.cr"
