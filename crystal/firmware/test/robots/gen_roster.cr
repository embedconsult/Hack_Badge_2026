# Writes src/robots/roster.cr: the robots crystal-robots ships (examples/
# and the code blocks of robots/*.md, both by Jason Kridner, GPL-2.0) as
# string literals, so the badge has opponents out of the box:
#   crystal/firmware/test/robots/upstream.sh
#   crystal run crystal/firmware/test/robots/gen_roster.cr
UP = "#{__DIR__}/upstream"

# Display order: the classic CROBOTS four first, then the wiki robots.
FILES = %w(examples/sniper.cr examples/rook.cr examples/counter.cr examples/rabbit.cr
  robots/hunter.md robots/circler.md robots/dodger.md robots/turret.md
  robots/wallhugger.md examples/target.cr)

entries = FILES.map do |f|
  text = File.read("#{UP}/#{f}")
  if f.ends_with?(".md")
    text = text.match(/```crystal\n(.*?)```/m).not_nil![1]
  end
  {File.basename(f).sub(/\.(cr|md)\z/, ""), text}
end

rev = File.read("#{UP}/.rev").strip
File.open("#{__DIR__}/../../src/robots/roster.cr", "w") do |io|
  io << "# Generated by test/robots/gen_roster.cr from crystal-robots #{rev[0, 10]}\n"
  io << "# (Jason Kridner, GPL-2.0); do not edit. The built-in robots.\n"
  io << "module Roster\n"
  io << "  COUNT = " << entries.size << "\n\n"
  io << "  def self.file(i : Int32) : String\n"
  entries.each_with_index { |(name, _), i| io << "    return " << name.inspect << " if i == " << i << "\n" }
  io << "    \"\"\n  end\n\n"
  io << "  def self.source(i : Int32) : String\n"
  entries.each_with_index { |(_, src), i| io << "    return " << src.inspect << " if i == " << i << "\n" }
  io << "    \"\"\n  end\nend\n"
end
puts "wrote src/robots/roster.cr (#{entries.size} robots)"
