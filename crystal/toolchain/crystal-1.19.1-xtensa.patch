Subject: [PATCH 3/3] Treat bare-metal *-elf triples as embedded (static reloc
 model)

---
 src/compiler/crystal/codegen/target.cr | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/compiler/crystal/codegen/target.cr b/src/compiler/crystal/codegen/target.cr
index c1181dd..bd55244 100644
--- a/src/compiler/crystal/codegen/target.cr
+++ b/src/compiler/crystal/codegen/target.cr
@@ -193,7 +193,7 @@ class Crystal::Codegen::Target
   end
 
   def embedded?
-    environment_parts.any? { |part| part == "eabi" || part == "eabihf" }
+    environment_parts.any? { |part| part == "eabi" || part == "eabihf" || part == "elf" }
   end
 
   def to_target_machine(cpu = "", features = "", optimization_mode = Compiler::OptimizationMode::O0,
