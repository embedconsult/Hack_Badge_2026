From 3e913a7f52354d5dfa3488a269b5750c1c20e896 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Fri, 6 Nov 2026 19:21:03 +0000
Subject: [PATCH 1/3] xtensa target + minimal ABI

---
 src/compiler/crystal/codegen/abi.cr        |  2 +
 src/compiler/crystal/codegen/abi/xtensa.cr | 66 ++++++++++++++++++++++
 src/compiler/crystal/codegen/target.cr     |  6 +-
 3 files changed, 72 insertions(+), 2 deletions(-)
 create mode 100644 src/compiler/crystal/codegen/abi/xtensa.cr

diff --git a/src/compiler/crystal/codegen/abi.cr b/src/compiler/crystal/codegen/abi.cr
index 2513446..87f7991 100644
--- a/src/compiler/crystal/codegen/abi.cr
+++ b/src/compiler/crystal/codegen/abi.cr
@@ -28,6 +28,8 @@ abstract class Crystal::ABI
       AVR.new(target_machine, target_machine.cpu)
     when /wasm32/
       Wasm32.new(target_machine)
+    when /xtensa/
+      Xtensa.new(target_machine)
     else
       raise "Unsupported ABI for target triple: #{triple}"
     end
diff --git a/src/compiler/crystal/codegen/abi/xtensa.cr b/src/compiler/crystal/codegen/abi/xtensa.cr
new file mode 100644
index 0000000..954fd40
--- /dev/null
+++ b/src/compiler/crystal/codegen/abi/xtensa.cr
@@ -0,0 +1,66 @@
+require "../abi"
+
+# Minimal Xtensa (windowed, call8) C ABI, modelled on ARM and on clang's
+# XtensaABIInfo: up to 6 argument words in a2..a7, aggregates <= 24 bytes are
+# passed directly (coerced to an i32/i64 array), larger ones byval in memory;
+# return values up to 16 bytes come back in a2..a5, larger ones via sret.
+class Crystal::ABI::Xtensa < Crystal::ABI
+  def abi_info(atys : Array(LLVM::Type), rty : LLVM::Type, ret_def : Bool, context : LLVM::Context) : Crystal::ABI::FunctionType
+    ret_ty = compute_return_type(rty, ret_def, context)
+    arg_tys = atys.map { |aty| compute_arg_type(aty, context) }
+    FunctionType.new(arg_tys, ret_ty)
+  end
+
+  def align(type : LLVM::Type) : Int32
+    align(type, 4)
+  end
+
+  def size(type : LLVM::Type) : Int32
+    size(type, 4)
+  end
+
+  def register?(type) : Bool
+    case type.kind
+    when LLVM::Type::Kind::Integer, LLVM::Type::Kind::Float, LLVM::Type::Kind::Double, LLVM::Type::Kind::Pointer
+      true
+    else
+      false
+    end
+  end
+
+  private def compute_return_type(rty, ret_def, context)
+    if !ret_def
+      ArgType.direct(context.void)
+    elsif register?(rty)
+      non_struct(rty, context)
+    else
+      case size(rty)
+      when 0
+        ArgType.ignore(rty)
+      when 1..4
+        ArgType.direct(rty, context.int32)
+      when 5..16
+        ArgType.direct(rty, context.int32.array(((size(rty) + 3) // 4).to_u64))
+      else
+        ArgType.indirect(rty, LLVM::Attribute::StructRet)
+      end
+    end
+  end
+
+  private def compute_arg_type(aty, context)
+    if register?(aty)
+      non_struct(aty, context)
+    elsif size(aty) > 24
+      ArgType.indirect(aty, LLVM::Attribute::ByVal)
+    elsif align(aty) <= 4
+      ArgType.direct(aty, context.int32.array(((size(aty) + 3) // 4).to_u64))
+    else
+      ArgType.direct(aty, context.int64.array(((size(aty) + 7) // 8).to_u64))
+    end
+  end
+
+  private def non_struct(type, context)
+    attr = type == context.int1 ? LLVM::Attribute::ZExt : nil
+    ArgType.direct(type, attr: attr)
+  end
+end
diff --git a/src/compiler/crystal/codegen/target.cr b/src/compiler/crystal/codegen/target.cr
index cf11ed9..c1181dd 100644
--- a/src/compiler/crystal/codegen/target.cr
+++ b/src/compiler/crystal/codegen/target.cr
@@ -53,7 +53,7 @@ class Crystal::Codegen::Target
     case @architecture
     when "aarch64", "x86_64"
       64
-    when "arm", "i386", "wasm32"
+    when "arm", "i386", "wasm32", "xtensa"
       32
     when "avr"
       16
@@ -66,7 +66,7 @@ class Crystal::Codegen::Target
     case @architecture
     when "aarch64", "x86_64"
       64
-    when "arm", "i386", "wasm32"
+    when "arm", "i386", "wasm32", "xtensa"
       32
     when "avr"
       16
@@ -221,6 +221,8 @@ class Crystal::Codegen::Target
       end
     when "wasm32"
       LLVM.init_webassembly
+    when "xtensa"
+      LLVM.init_xtensa
     else
       raise Target::Error.new("Unsupported architecture for target triple: #{self}")
     end
