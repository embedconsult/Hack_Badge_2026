From 42dd0740b6b78142100f740a7f9bfc35b5863e1f Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Fri, 6 Nov 2026 19:32:20 +0000
Subject: [PATCH 2/3] Linux/glibc: fall back when pthread_getattr_np fails (no
 /proc)

---
 src/crystal/system/unix/pthread.cr | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/src/crystal/system/unix/pthread.cr b/src/crystal/system/unix/pthread.cr
index e919906..0354240 100644
--- a/src/crystal/system/unix/pthread.cr
+++ b/src/crystal/system/unix/pthread.cr
@@ -143,7 +143,14 @@ module Crystal::System::Thread
       raise RuntimeError.from_os_error("pthread_attr_destroy", Errno.new(ret)) unless ret == 0
     {% elsif flag?(:linux) %}
       ret = LibC.pthread_getattr_np(@system_handle, out attr)
-      raise RuntimeError.from_os_error("pthread_getattr_np", Errno.new(ret)) unless ret == 0
+      unless ret == 0
+        # glibc reads /proc/self/maps for the main thread; without /proc
+        # (e.g. a chroot without /proc) estimate the stack bottom assuming
+        # the default 8 MiB RLIMIT_STACK; only used for overflow detection.
+        # (glibc only needs /proc for the main thread, so that's the case here.)
+        here = 0
+        return Pointer(Void).new(pointerof(here).address &- (8_u64 << 20))
+      end
 
       LibC.pthread_attr_getstack(pointerof(attr), pointerof(address), out stack_size)
 
-- 
2.49.1


From 444b94f8ec1d9852bcc6aebdf95475d3b5bc00f4 Mon Sep 17 00:00:00 2001
From: x <x@x>
